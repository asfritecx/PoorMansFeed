<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:GraphiteUi"
             xmlns:local="using:PoorMansFeed"
             x:Class="PoorMansFeed.App"
             Name="{x:Static ui:AppInfo.Name}"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark setting; the Graphite theme defines both -->
    <Application.Styles>
        <FluentTheme>
            <!-- Graphite's accent and primary text, fixed so the accent does not follow the macOS highlight colour
                 and the colours Fluent derives at load (focus ring, control text) match. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1767D0" BaseHigh="#16191E" />
                <ColorPaletteResources x:Key="Dark" Accent="#7AB4FF" BaseHigh="#F2F4F7" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/GraphiteUi/Theme.axaml" />
    </Application.Styles>
    <!-- Without this menu Avalonia adds "About Avalonia" to the macOS app menu -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static ui:AppInfo.AboutMenuHeader}" Click="ShowAboutClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{x:Static local:AppText.MenuSettings}" Click="ShowSettingsClicked" />
            <NativeMenuItem Header="{x:Static local:AppText.MenuResetToken}" Click="ResetTokenClicked" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>
