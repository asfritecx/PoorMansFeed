<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:GraphiteUi"
        xmlns:vm="using:PoorMansFeed"
        x:Class="PoorMansFeed.HelpDialog"
        Title="{x:Static ui:AppInfo.HelpTitle}"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The sections scroll inside a capped height, so the dialog is at most 640px of content and Close stays in view -->
  <Grid Margin="24" RowDefinitions="Auto,Auto" RowSpacing="16">
    <ScrollViewer x:Name="HelpScroll" MaxHeight="540">
      <StackPanel Spacing="16">
        <TextBlock x:Name="TitleText" Text="{x:Static ui:AppInfo.HelpTitle}" Classes="subtitle" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static vm:AppText.HelpTokenHeading}" Classes="card-title" />
          <TextBlock Text="{x:Static vm:AppText.HelpTokenText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static vm:AppText.HelpDatasetHeading}" Classes="card-title" />
          <TextBlock x:Name="DatasetText" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static vm:AppText.HelpSearchHeading}" Classes="card-title" />
          <TextBlock x:Name="SearchText" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static vm:AppText.HelpExportHeading}" Classes="card-title" />
          <TextBlock Text="{x:Static vm:AppText.HelpExportText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static vm:AppText.HelpAbuseHeading}" Classes="card-title" />
          <TextBlock x:Name="AbuseText" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock x:Name="ModSecurityHeading" Text="{x:Static vm:AppText.HelpModSecurityHeading}" Classes="card-title" />
          <ItemsControl x:Name="HelpModSecurityList" ItemsSource="{x:Static vm:AppText.HelpModSecurityTexts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1" Content="{x:Static vm:AppText.Close}" HorizontalAlignment="Right" MinWidth="88"
            IsDefault="True" IsCancel="True" Click="CloseClicked" />
  </Grid>
</Window>
