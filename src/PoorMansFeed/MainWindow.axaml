<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PoorMansFeed"
        xmlns:ui="using:GraphiteUi"
        x:Class="PoorMansFeed.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static ui:AppInfo.Title}"
        Width="1280"
        Height="880"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <!-- Graphite's shell: the app bar across the top and the nav pane down the left, both on bg-window, and the page on
       the content layer -->
  <Grid x:Name="Shell" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
    <!-- App bar: product icon, name and version on the left; the dataset pill and the icon buttons on the right -->
    <Border x:Name="AppBar" Grid.ColumnSpan="2">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ui:LineIcon Data="{StaticResource IconGlobe}" Width="18" Height="18" />
          <TextBlock Text="{x:Static ui:AppInfo.Name}" Classes="body-strong" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionLabel" Text="{x:Static ui:AppInfo.VersionLabel}" Classes="caption"
                     VerticalAlignment="Center" />
        </StackPanel>
        <!-- The dataset pill opens the dataset's drop-down. Only the state word is a live region: the percent after it
             changes on every report, and a screen reader hears state changes only. -->
        <Button x:Name="DatasetPillButton" Grid.Column="2" Classes="chip" VerticalAlignment="Center"
                IsEnabled="{Binding CanOpenDatasetPill}" ToolTip.Tip="{x:Static vm:AppText.DatasetPillTooltip}"
                AutomationProperties.Name="{x:Static vm:AppText.DatasetPillName}"
                AutomationProperties.HelpText="{Binding PillText}">
          <Border x:Name="DatasetPill" Classes="pill" Classes.warning="{Binding IsPillWarning}"
                  Classes.success="{Binding IsPillSuccess}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="dot" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PillState" Text="{Binding PillStateText}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="PillProgress" Text="{Binding PillProgressText}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="panel"
                    Closed="DatasetFlyoutClosed">
              <!-- Read-only while Refresh all runs: every action is off then. It overlays the page, so its height follows
                   its detail (at most three lines) and moves nothing else. -->
              <StackPanel x:Name="DatasetPanel" Width="360" Spacing="4">
                <TextBlock x:Name="DatasetStatus" Text="{Binding DatasetStatusText}" Classes="card-title"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DatasetDetail" Text="{Binding DatasetDetailText}" Classes="secondary"
                           LineHeight="22" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding DatasetDetailText}" />
                <TextBlock x:Name="DatasetFacts" Text="{Binding DatasetFactsText}" Classes="caption"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Height="36" Margin="0,12,0,0">
                  <Button x:Name="CheckForUpdatesButton" Content="{x:Static vm:AppText.CheckForUpdates}"
                          Command="{Binding CheckForUpdatesCommand}" Click="DatasetActionClicked"
                          ToolTip.Tip="{x:Static vm:AppText.DatasetCheckTooltip}" />
                  <!-- One place: Update dataset... while idle, Show progress while this window's update runs -->
                  <Panel>
                    <Button x:Name="UpdateButton" Classes="accent" Command="{Binding UpdateDatasetInWindowCommand}"
                            Click="DatasetActionClicked" IsVisible="{Binding !IsBusy}"
                            ToolTip.Tip="{x:Static vm:AppText.UpdateDatasetEllipsisTooltip}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:LineIcon Data="{StaticResource IconCloudDownload}" />
                        <TextBlock Text="{x:Static vm:AppText.UpdateDatasetEllipsis}" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="ShowProgressButton" Content="{x:Static vm:AppText.ShowProgress}"
                            Command="{Binding ShowUpdateWindowCommand}" Click="DatasetActionClicked"
                            IsVisible="{Binding IsBusy}" ToolTip.Tip="{x:Static vm:AppText.ShowProgressTooltip}" />
                  </Panel>
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="HelpButton" Grid.Column="3" Classes="subtle" VerticalAlignment="Center"
                ToolTip.Tip="{x:Static ui:AppInfo.HelpTitle}"
                AutomationProperties.Name="{x:Static ui:AppInfo.HelpTitle}" Click="ShowHelpClicked">
          <ui:LineIcon Data="{StaticResource IconCircleHelp}" />
        </Button>
        <Button x:Name="AboutButton" Grid.Column="4" Classes="subtle" VerticalAlignment="Center"
                ToolTip.Tip="{x:Static ui:AppInfo.AboutTitle}"
                AutomationProperties.Name="{x:Static ui:AppInfo.AboutTitle}" Click="ShowAboutClicked">
          <ui:LineIcon Data="{StaticResource IconInfo}" />
        </Button>
      </Grid>
    </Border>

    <!-- Nav pane: one item per page, always one selected; Settings is docked at the foot of the list, above the
         attribution. The list doesn't scroll, so its panel is measured at the pane's height. -->
    <Grid x:Name="NavPane" Grid.Row="1" RowDefinitions="*,Auto">
      <ListBox x:Name="NavList" Classes="nav" SelectionMode="AlwaysSelected" SelectedIndex="0"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               SelectionChanged="NavSelectionChanged" AutomationProperties.Name="{x:Static vm:AppText.NavName}"
               IsEnabled="{Binding !IsStopped}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <vm:NavItemsPanel LastChildFill="False" VerticalSpacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBoxItem x:Name="NavLookup" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.Title}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconSearch}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.Title}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavGoogleCloud" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.GoogleCloudTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconCloud}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.GoogleCloudTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavAzure" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.AzureTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconCloud}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.AzureTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavAws" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.AwsTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconCloud}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.AwsTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavCloudSearch" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.CloudSearchTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconSearch}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.CloudSearchTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavAbuseIpDb" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.AbuseIpDbTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconTriangleAlert}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.AbuseIpDbTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavSavedFeeds" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.SavedFeedsTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconFileText}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.SavedFeedsTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavChangeHistory" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static vm:AppText.HistoryTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconClock}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.HistoryTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="NavSettings" DockPanel.Dock="Bottom" AutomationProperties.Name="{x:Static vm:AppText.SettingsTitle}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ui:LineIcon Data="{StaticResource IconSettings}" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:AppText.SettingsTitle}" VerticalAlignment="Center" />
            <!-- Shown from every page while the Settings page has unsaved edits; its context is that page, set in code.
                 Hidden, it keeps its space, so the item never changes size. -->
            <TextBlock x:Name="NavSettingsMark" x:DataType="vm:SettingsPageViewModel" Text="{x:Static vm:AppText.SettingsNotSavedMark}"
                       Classes="small caution" Classes.placeholder="{Binding !HasUnsavedChanges, FallbackValue=True}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
      <TextBlock x:Name="FooterNotice" Grid.Row="1" Text="{x:Static vm:AppText.Attribution}" Classes="caption quaternary"
                 TextWrapping="Wrap" Margin="20,16" />
    </Grid>

    <!-- Content layer. The frame is as tall as the viewport, so each list card takes the height left over. MinHeight
         is the tallest page with a 216px list, measured headlessly; below it the page scrolls. -->
    <Border x:Name="ContentLayer" Grid.Row="1" Grid.Column="1">
      <Panel>
        <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsStopped}">
          <Border x:Name="PageFrame" Padding="32" MinHeight="598" Height="{Binding #PageScroll.Viewport.Height}">
            <Grid RowDefinitions="Auto,*" RowSpacing="32">

              <!-- Page headings: one per tool, swapped with the pages below -->
              <Panel>
                <StackPanel x:Name="LookupHeading" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static vm:AppText.Title}" Classes="title" />
                  <TextBlock Text="{x:Static vm:AppText.Caption}" Classes="caption" />
                </StackPanel>
                <StackPanel x:Name="ToolsHeading" Spacing="2" VerticalAlignment="Center" IsVisible="False">
                  <TextBlock Text="{x:Static vm:AppText.GoogleCloudTitle}" Classes="title" />
                  <TextBlock Text="{x:Static vm:AppText.GoogleCloudCaption}" Classes="caption" />
                </StackPanel>
                <Grid x:Name="AzureHeading" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False"
                      x:DataType="vm:AzureFeedViewModel">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static vm:AppText.AzureTitle}" Classes="title" />
                    <TextBlock Text="{x:Static vm:AppText.AzureCaption}" Classes="caption" />
                  </StackPanel>
                  <Button x:Name="AzureCheckForUpdatesButton" Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                          VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:AppText.CheckForUpdatesTooltip}"
                          AutomationProperties.Name="{x:Static vm:AppText.CheckForUpdates}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ui:LineIcon Data="{StaticResource IconCloudDownload}" />
                      <TextBlock Text="{x:Static vm:AppText.CheckForUpdates}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid x:Name="AwsHeading" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False"
                      x:DataType="vm:AwsFeedViewModel">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static vm:AppText.AwsTitle}" Classes="title" />
                    <TextBlock Text="{x:Static vm:AppText.AwsCaption}" Classes="caption" />
                  </StackPanel>
                  <Button x:Name="AwsCheckForUpdatesButton" Grid.Column="1" Command="{Binding CheckForUpdatesCommand}"
                          VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:AppText.AwsCheckForUpdatesTooltip}"
                          AutomationProperties.Name="{x:Static vm:AppText.CheckForUpdates}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ui:LineIcon Data="{StaticResource IconCloudDownload}" />
                      <TextBlock Text="{x:Static vm:AppText.CheckForUpdates}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <StackPanel x:Name="CloudSearchHeading" Spacing="2" VerticalAlignment="Center" IsVisible="False">
                  <TextBlock Text="{x:Static vm:AppText.CloudSearchTitle}" Classes="title" />
                  <TextBlock Text="{x:Static vm:AppText.CloudSearchCaption}" Classes="caption" />
                </StackPanel>
                <Grid x:Name="AbuseIpDbHeading" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False"
                      x:DataType="vm:AbuseIpDbViewModel">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static vm:AppText.AbuseIpDbTitle}" Classes="title" />
                    <TextBlock Text="{x:Static vm:AppText.AbuseIpDbCaption}" Classes="caption" />
                  </StackPanel>
                  <Button x:Name="ShowNewAddressesButton" Grid.Column="1" Command="{Binding ShowNewAddressesCommand}"
                          Content="{x:Static vm:AppText.NewAddresses}" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static vm:AppText.NewAddressesTooltip}"
                          AutomationProperties.Name="{x:Static vm:AppText.NewAddresses}" />
                </Grid>
                <Grid x:Name="SavedFeedsHeading" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False"
                      x:DataType="vm:SavedFeedsViewModel">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static vm:AppText.SavedFeedsTitle}" Classes="title" />
                    <TextBlock Text="{x:Static vm:AppText.SavedFeedsCaption}" Classes="caption" />
                  </StackPanel>
                  <Button x:Name="RefreshAllButton" Grid.Column="1" Command="{Binding RefreshAllCommand}"
                          Content="{Binding RefreshAllText}" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding RefreshAllTip}"
                          AutomationProperties.Name="{Binding RefreshAllText}" />
                </Grid>
                <Grid x:Name="ChangeHistoryHeading" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False"
                      x:DataType="vm:SavedFeedsViewModel">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static vm:AppText.HistoryTitle}" Classes="title" />
                    <TextBlock Text="{x:Static vm:AppText.HistoryCaption}" Classes="caption" />
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="SettingsHeading" Spacing="2" VerticalAlignment="Center" IsVisible="False">
                  <TextBlock Text="{x:Static vm:AppText.SettingsTitle}" Classes="title" />
                  <TextBlock Text="{x:Static vm:AppText.SettingsCaption}" Classes="caption" />
                </StackPanel>
              </Panel>

              <!-- Pages: each is a control card over a results section whose card fills the rest of the frame -->
              <Panel Grid.Row="1">
                <Grid x:Name="LookupPage" RowDefinitions="Auto,*" RowSpacing="24">
                  <!-- Search: Enter runs the default button only while this page is showing -->
                  <Border Classes="card compact">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Classes="mono"
                               PlaceholderText="{x:Static vm:AppText.SearchPlaceholder}" MaxLength="64"
                               AutomationProperties.Name="{x:Static vm:AppText.SearchBoxName}" />
                      <Button x:Name="SearchButton" Grid.Column="1" IsDefault="True" Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ui:LineIcon Data="{StaticResource IconSearch}" />
                          <TextBlock Text="{x:Static vm:AppText.SearchButton}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>

                  <!-- Results: the card has a fixed header; the empty text and the list swap inside it -->
                  <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <!-- The summary has a row of its own across the card, so a long IPv6 address shows whole at the
                         minimum width; the buttons share the first row with the title -->
                    <Grid x:Name="ResultsTitleBar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                          RowSpacing="2" Margin="2,0,2,4">
                      <TextBlock Text="{x:Static vm:AppText.ResultsHeader}" Classes="section-title" VerticalAlignment="Center" />
                      <TextBlock x:Name="ResultsSummary" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ResultsSummaryText}"
                                 Classes="caption" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button x:Name="ModSecurityRulesButton" Content="{x:Static vm:AppText.ModSecurityRulesButton}"
                                Command="{Binding ModSecurityRulesCommand}" IsVisible="{Binding ShowsModSecurityRules}" />
                        <Button x:Name="CopyResultsButton" Classes="subtle" Command="{Binding CopyResultsCommand}"
                                ToolTip.Tip="{x:Static vm:AppText.CopyTooltip}"
                                AutomationProperties.Name="{x:Static vm:AppText.CopyName}">
                          <ui:LineIcon Data="{StaticResource IconCopy}" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="CheckAbuseButton" Command="{Binding CheckAbuseCommand}" Content="{x:Static vm:AppText.CheckAbuse}"
                                ToolTip.Tip="{x:Static vm:AppText.CheckAbuseTooltip}" />
                        <Button x:Name="OpenFolderButton" Command="{Binding OpenExportFolderCommand}"
                                ToolTip.Tip="{x:Static vm:AppText.OpenFolderName}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{x:Static vm:AppText.OpenFolder}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Command="{Binding ExportCommand}"
                                ToolTip.Tip="{x:Static vm:AppText.ExportTooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconDownload}" />
                            <TextBlock Text="{x:Static vm:AppText.Export}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <Border x:Name="ResultsCard" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                      <Grid RowDefinitions="36,*">
                        <Grid x:Name="ResultsHeader" Margin="16,0" ColumnDefinitions="2*,1.4*,2*,1.2*,96" ColumnSpacing="12">
                          <TextBlock Text="{x:Static vm:AppText.ColumnNetwork}" Classes="caption" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{x:Static vm:AppText.ColumnCountry}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{x:Static vm:AppText.ColumnAs}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{x:Static vm:AppText.ColumnDomain}" Classes="caption"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Panel Grid.Row="1">
                          <TextBlock x:Name="ResultsEmpty" Text="{Binding ResultsEmptyText}" Classes="caption" Margin="16,12"
                                     TextWrapping="Wrap" IsVisible="{Binding !HasResults}" />
                          <!-- Virtualized: only the visible rows exist. Every row has the fixed height of Border.row. -->
                          <ScrollViewer IsVisible="{Binding HasResults}">
                            <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
                              <!-- One menu for the list: a row's right-click bubbles up to it. Its pages come from the
                                   search, which every row shares, and its copies from the row the window recorded -->
                              <ItemsControl.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="{x:Static vm:AppText.OpenInIpinfo}" Command="{Binding OpenInIpinfoCommand}" />
                                  <MenuItem Header="{x:Static vm:AppText.OpenInAbuseIpDb}" Command="{Binding OpenInAbuseIpDbCommand}" />
                                  <MenuItem Header="{x:Static vm:AppText.CopyNetwork}" Command="{Binding CopyNetworkCommand}" />
                                  <MenuItem Header="{x:Static vm:AppText.CopyAsNumber}" Command="{Binding CopyAsNumberCommand}" />
                                </ContextMenu>
                              </ItemsControl.ContextMenu>
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResultRow">
                                  <!-- Transparent, so a right-click in a gap between the columns still reaches the list -->
                                  <Border Classes="row" Background="Transparent" AutomationProperties.Name="{Binding AccessibleText}">
                                    <Grid ColumnDefinitions="2*,1.4*,2*,1.2*,96" ColumnSpacing="12">
                                      <TextBlock Text="{Binding NetworkText}" Classes="mono" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding NetworkText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding CountryText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding CountryText}" />
                                      <TextBlock Grid.Column="2" Text="{Binding AsText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding AsText}" />
                                      <TextBlock Grid.Column="3" Text="{Binding DomainText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding DomainText}" />
                                      <Border Grid.Column="4" Classes="badge caution" IsVisible="{Binding IsLargeRange}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static vm:AppText.LargeRangeBadge}" />
                                      </Border>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Panel>
                      </Grid>
                    </Border>

                    <!-- Outcome of Export, Copy and Open folder; always present, so the page does not move -->
                    <TextBlock x:Name="ResultsAction" Grid.Row="2" Text="{Binding ResultsActionText}" Classes="caption"
                               Height="18" Classes.placeholder="{Binding !HasResultsAction}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ResultsActionText}" AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </Grid>

                <Grid x:Name="ToolsPage" RowDefinitions="Auto,*" RowSpacing="24" IsVisible="False"
                      x:DataType="vm:GoogleCloudFeedViewModel">
                  <Border Classes="card compact">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <ComboBox x:Name="RegionBox" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                                HorizontalAlignment="Stretch" IsEnabled="{Binding !IsWorking}"
                                AutomationProperties.Name="{x:Static vm:AppText.ColumnRegion}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:RegionOption">
                            <TextBlock Text="{Binding Text}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <CheckBox x:Name="AddGlobalBox" Grid.Column="1" Content="{x:Static vm:AppText.AddGlobalRanges}"
                                IsChecked="{Binding IncludeGlobal}" IsEnabled="{Binding CanIncludeGlobal}"
                                VerticalAlignment="Center" />
                      <Button x:Name="CheckRangesButton" Grid.Column="2" Command="{Binding CheckCommand}"
                              AutomationProperties.Name="{x:Static vm:AppText.CheckRanges}" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static vm:AppText.CheckRanges}" />
                      </Button>
                    </Grid>
                  </Border>

                  <vm:CloudRangesPanel Grid.Row="1" />
                </Grid>

                <Grid x:Name="AzurePage" RowDefinitions="Auto,*" RowSpacing="24" IsVisible="False"
                      x:DataType="vm:AzureFeedViewModel">
                  <Border Classes="card compact">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                        <ComboBox x:Name="ServiceBox" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsWorking}"
                                  AutomationProperties.Name="{x:Static vm:AppText.ColumnService}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AzureServiceOption">
                              <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="AzureRegionBox" Grid.Column="1" ItemsSource="{Binding Regions}"
                                  SelectedItem="{Binding SelectedRegion}" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsWorking}" AutomationProperties.Name="{x:Static vm:AppText.ColumnRegion}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AzureTagOption">
                              <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="AzureCheckRangesButton" Grid.Column="2" Command="{Binding CheckCommand}"
                                AutomationProperties.Name="{x:Static vm:AppText.CheckRanges}" VerticalAlignment="Center">
                          <TextBlock Text="{x:Static vm:AppText.CheckRanges}" />
                        </Button>
                      </Grid>
                      <TextBlock x:Name="AzureStatus" Text="{Binding StatusText}" Classes="caption" Height="18"
                                 TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </Border>

                  <vm:CloudRangesPanel Grid.Row="1" />
                </Grid>

                <Grid x:Name="AwsPage" RowDefinitions="Auto,*" RowSpacing="24" IsVisible="False"
                      x:DataType="vm:AwsFeedViewModel">
                  <Border Classes="card compact">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                        <ComboBox x:Name="AwsServiceBox" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsWorking}"
                                  AutomationProperties.Name="{x:Static vm:AppText.ColumnService}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AwsServiceOption">
                              <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="AwsRegionBox" Grid.Column="1" ItemsSource="{Binding Regions}"
                                  SelectedItem="{Binding SelectedRegion}" HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !IsWorking}" AutomationProperties.Name="{x:Static vm:AppText.ColumnRegion}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AwsRegionOption">
                              <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="AwsCheckRangesButton" Grid.Column="2" Command="{Binding CheckCommand}"
                                AutomationProperties.Name="{x:Static vm:AppText.CheckRanges}" VerticalAlignment="Center">
                          <TextBlock Text="{x:Static vm:AppText.CheckRanges}" />
                        </Button>
                      </Grid>
                      <TextBlock x:Name="AwsStatus" Text="{Binding StatusText}" Classes="caption" Height="18"
                                 TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </Border>

                  <vm:CloudRangesPanel Grid.Row="1" />
                </Grid>

                <!-- Cloud Address Lookup: Enter in the box searches (CloudSearchBoxKeyDown), so its button is never the
                     default. Each show reads the source lines, which keep their height until that read lands. -->
                <Grid x:Name="CloudSearchPage" RowDefinitions="Auto,*" RowSpacing="24" IsVisible="False"
                      x:DataType="vm:CloudAddressSearchViewModel">
                  <Border x:Name="CloudSearchControls" Classes="card compact">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="CloudSearchBox" Text="{Binding Query}" Classes="mono" MaxLength="64"
                                 PlaceholderText="{x:Static vm:AppText.CloudSearchPlaceholder}"
                                 AutomationProperties.Name="{x:Static vm:AppText.CloudSearchBoxName}"
                                 KeyDown="CloudSearchBoxKeyDown" />
                        <Button x:Name="CloudSearchButton" Grid.Column="1" Command="{Binding SearchCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconSearch}" />
                            <TextBlock Text="{x:Static vm:AppText.SearchButton}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <StackPanel Spacing="2">
                        <TextBlock x:Name="CloudSearchGoogleSource" Text="{Binding GoogleSourceText}" Classes="caption"
                                   Height="18" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GoogleSourceText}"
                                   Classes.placeholder="{Binding !HasSourceTexts}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="CloudSearchAzureSource" Text="{Binding AzureSourceText}" Classes="caption"
                                   Height="18" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AzureSourceText}"
                                   Classes.placeholder="{Binding !HasSourceTexts}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="CloudSearchAwsSource" Text="{Binding AwsSourceText}" Classes="caption"
                                   Height="18" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AwsSourceText}"
                                   Classes.placeholder="{Binding !HasSourceTexts}" AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <Grid x:Name="CloudSearchTitleBar" RowDefinitions="Auto,Auto" RowSpacing="2" Margin="2,0,2,4">
                      <TextBlock Text="{x:Static vm:AppText.CloudSearchResultsHeader}" Classes="section-title" />
                      <TextBlock x:Name="CloudSearchSummary" Grid.Row="1" Text="{Binding SummaryText}" Classes="caption"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SummaryText}"
                                 AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <Border x:Name="CloudSearchCard" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                      <Grid RowDefinitions="36,*">
                        <!-- Two caption lines over the rows' two lines, in the same columns -->
                        <Grid x:Name="CloudSearchHeader" Margin="16,0" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                          <Grid ColumnDefinitions="*,96,168" ColumnSpacing="12">
                            <TextBlock Text="{x:Static vm:AppText.ColumnNetwork}" Classes="caption" />
                            <TextBlock Grid.Column="1" Text="{x:Static vm:AppText.ColumnProvider}" Classes="caption" />
                            <TextBlock Grid.Column="2" Text="{x:Static vm:AppText.ColumnRegion}" Classes="caption" />
                          </Grid>
                          <Grid Grid.Row="1" ColumnDefinitions="*,96,168" ColumnSpacing="12">
                            <TextBlock Text="{x:Static vm:AppText.ColumnService}" Classes="caption" />
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static vm:AppText.ColumnScope}" Classes="caption" />
                          </Grid>
                        </Grid>
                        <Panel Grid.Row="1">
                          <TextBlock x:Name="CloudSearchEmpty" Text="{Binding EmptyText}" Classes="caption" Margin="16,12"
                                     TextWrapping="Wrap" IsVisible="{Binding !HasRows}" />
                          <!-- Virtualized: only the visible rows exist.
                               Every row has the fixed height of Border.row.notice. -->
                          <ScrollViewer IsVisible="{Binding HasRows}">
                            <ItemsControl x:Name="CloudSearchList" ItemsSource="{Binding Rows}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CloudAddressRow">
                                  <!-- Transparent, so a right-click in a gap between the columns still reaches
                                       the row's menu -->
                                  <Border Classes="row notice" Background="Transparent" AutomationProperties.Name="{Binding AccessibleText}">
                                    <Border.ContextMenu>
                                      <ContextMenu>
                                        <!-- Level 1: the menu is itself an ItemsControl,
                                             so the first one up is the menu, not the list -->
                                        <MenuItem Header="{x:Static vm:AppText.CopyNetwork}"
                                                  Command="{Binding $parent[ItemsControl;1].((vm:CloudAddressSearchViewModel)DataContext).CopyNetworkCommand}"
                                                  CommandParameter="{Binding}" />
                                      </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                                      <Grid ColumnDefinitions="*,96,168" ColumnSpacing="12">
                                        <TextBlock Text="{Binding NetworkText}" Classes="mono" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding NetworkText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProviderText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding ProviderText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding RegionText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding RegionText}" />
                                      </Grid>
                                      <Grid Grid.Row="1" ColumnDefinitions="*,96,168" ColumnSpacing="12">
                                        <TextBlock Text="{Binding ServiceText}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding ServiceText}" />
                                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ScopeText}" Classes="caption"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ScopeText}" />
                                      </Grid>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Panel>
                      </Grid>
                    </Border>

                    <!-- A failed copy's line; always present, so the page does not move -->
                    <TextBlock x:Name="CloudSearchAction" Grid.Row="2" Text="{Binding ActionText}" Classes="caption"
                               Height="18" Classes.placeholder="{Binding !HasActionText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ActionText}" AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </Grid>

                <!-- AbuseIPDB Blacklist: the list's facts and its two actions over the offending networks, a report grouped by
                     IPinfo's ASN. The two-line status and the grouping bar share one 36px panel, so neither moves the page. -->
                <Grid x:Name="AbuseIpDbPage" RowDefinitions="Auto,*" RowSpacing="24" IsVisible="False"
                      x:DataType="vm:AbuseIpDbViewModel">
                  <Border Classes="card compact">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <!-- Two lines in the buttons' 36px: the last download, then the downloads left and the counts. Both
                             tips and the name are the whole line; an empty second line keeps its space. -->
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="AbuseFacts" Text="{Binding FactsHeadText}" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding FactsText}" AutomationProperties.Name="{Binding FactsText}" />
                          <TextBlock x:Name="AbuseFactsDetail" Text="{Binding FactsDetailText}" Classes="caption"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FactsText}"
                                     AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                        <Button x:Name="DownloadBlacklistButton" Grid.Column="1" Command="{Binding DownloadCommand}"
                                VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:AppText.DownloadBlacklistTooltip}"
                                AutomationProperties.Name="{x:Static vm:AppText.DownloadBlacklist}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconCloudDownload}" />
                            <TextBlock Text="{x:Static vm:AppText.DownloadBlacklist}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="ClearListButton" Grid.Column="2" Command="{Binding ClearListCommand}"
                                VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:AppText.ClearListTooltip}"
                                AutomationProperties.Name="{x:Static vm:AppText.ClearList}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconTrash2}" Classes="danger" />
                            <TextBlock Text="{x:Static vm:AppText.ClearList}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <Panel Height="36">
                        <TextBlock x:Name="AbuseStatus" Text="{Binding StatusText}" Classes="caption"
                                   Classes.caution="{Binding IsStatusWarning}" TextWrapping="Wrap" MaxLines="2"
                                   VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" />
                        <!-- Determinate only: placeholder hides it but would not stop an indeterminate bar animating -->
                        <ProgressBar x:Name="AbuseGroupingBar" Minimum="0" Maximum="1" Value="{Binding GroupingProgress}"
                                     VerticalAlignment="Bottom" Classes.placeholder="{Binding !IsGrouping}"
                                     AutomationProperties.Name="{x:Static vm:AppText.AbuseGroupingBarName}" />
                      </Panel>
                    </StackPanel>
                  </Border>

                  <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <!-- The summary has a row of its own across the page, so its report note shows whole at the
                         minimum width while the rules button shows; the buttons share the first row with the title -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2"
                          Margin="2,0,2,4">
                      <TextBlock Text="{x:Static vm:AppText.AbuseNetworksHeader}" Classes="section-title"
                                 VerticalAlignment="Center" />
                      <TextBlock x:Name="AbuseSummary" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SummaryText}"
                                 Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SummaryText}"
                                 AutomationProperties.LiveSetting="Polite" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button x:Name="AbuseModSecurityRulesButton" Content="{x:Static vm:AppText.ModSecurityRulesButton}"
                                Command="{Binding ModSecurityRulesCommand}" IsVisible="{Binding ShowsModSecurityRules}" />
                        <Button x:Name="AbuseOpenFolderButton" Command="{Binding OpenFolderCommand}"
                                ToolTip.Tip="{x:Static vm:AppText.OpenFolderName}"
                                AutomationProperties.Name="{x:Static vm:AppText.OpenFolderName}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{x:Static vm:AppText.OpenFolder}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="EmptyFeedButton" Command="{Binding EmptyFeedCommand}"
                                ToolTip.Tip="{x:Static vm:AppText.RetireFeedTooltip}"
                                AutomationProperties.Name="{x:Static vm:AppText.RetireFeed}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconFile}" />
                            <TextBlock Text="{x:Static vm:AppText.RetireFeed}" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="AbuseWriteFeedButton" Command="{Binding WriteFeedCommand}"
                                ToolTip.Tip="{Binding WriteFeedTooltip}"
                                AutomationProperties.Name="{x:Static vm:AppText.WriteFeed}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:LineIcon Data="{StaticResource IconDownload}" />
                            <TextBlock Text="{x:Static vm:AppText.WriteFeed}" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <Border x:Name="AbuseNetworksCard" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                      <Grid RowDefinitions="36,*">
                        <Grid Margin="16,0" ColumnDefinitions="1.4*,1.9*,1.6*,1*,1.8*,28" ColumnSpacing="12">
                          <TextBlock Text="{x:Static vm:AppText.ColumnAs}" Classes="caption" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{x:Static vm:AppText.ColumnName}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{x:Static vm:AppText.ColumnDomain}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{x:Static vm:AppText.ColumnAddresses}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="{x:Static vm:AppText.ColumnCountries}" Classes="caption"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <Panel Grid.Row="1">
                          <TextBlock x:Name="AbuseNetworksEmpty" Text="{Binding EmptyText}" Classes="caption" Margin="16,12"
                                     TextWrapping="Wrap" IsVisible="{Binding !HasRows}" />
                          <!-- Virtualized: only the visible rows exist. Every row has the fixed height of Border.row. -->
                          <ScrollViewer IsVisible="{Binding HasRows}">
                            <ItemsControl x:Name="AbuseNetworkList" ItemsSource="{Binding Rows}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OffendingNetworkRow">
                                  <!-- Transparent, so a right-click in a gap between the columns still reaches the row's menu -->
                                  <Border Classes="row" Background="Transparent" AutomationProperties.Name="{Binding AccessibleText}">
                                    <Border.ContextMenu>
                                      <ContextMenu>
                                        <!-- Level 1: the menu is itself an ItemsControl, so the first one up is the menu, not the list -->
                                        <MenuItem Header="{x:Static vm:AppText.OpenInIpinfo}"
                                                  Command="{Binding $parent[ItemsControl;1].((vm:AbuseIpDbViewModel)DataContext).OpenNetworkInIpinfoCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{x:Static vm:AppText.CopyAsNumber}"
                                                  Command="{Binding $parent[ItemsControl;1].((vm:AbuseIpDbViewModel)DataContext).CopyAsNumberCommand}"
                                                  CommandParameter="{Binding}" />
                                      </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="1.4*,1.9*,1.6*,1*,1.8*,28" ColumnSpacing="12">
                                      <TextBlock Text="{Binding AsnText}" Classes="mono" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding AsnText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding NameText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding NameText}" />
                                      <TextBlock Grid.Column="2" Text="{Binding DomainText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding DomainText}" />
                                      <TextBlock Grid.Column="3" Text="{Binding AddressesText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding AddressesText}" />
                                      <TextBlock Grid.Column="4" Text="{Binding CountriesText}" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" ToolTip.Tip="{Binding CountriesText}" />
                                      <!-- The command is the page's, reached from the row through the list's context -->
                                      <Button Grid.Column="5" Classes="subtle small" VerticalAlignment="Center"
                                              Command="{Binding $parent[ItemsControl].((vm:AbuseIpDbViewModel)DataContext).LookUpCommand}"
                                              CommandParameter="{Binding}" ToolTip.Tip="{Binding LookUpName}"
                                              AutomationProperties.Name="{Binding LookUpName}">
                                        <ui:LineIcon Data="{StaticResource IconSearch}" Width="14" Height="14" />
                                      </Button>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Panel>
                      </Grid>
                    </Border>

                    <!-- Outcome of Write feed, Retire feed and Open folder, in two lines; always there, so the page does not move -->
                    <TextBlock x:Name="AbuseAction" Grid.Row="2" Text="{Binding ActionText}" Classes="caption" Height="36"
                               TextWrapping="Wrap" MaxLines="2" Classes.placeholder="{Binding !HasActionText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ActionText}" AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                </Grid>

                <!-- Saved feeds: the feeds, whose card takes the height left, over the action line. Change history is a
                     page of its own on the same view model, so neither page scrolls inside the frame. -->
                <Grid x:Name="SavedFeedsPage" RowDefinitions="Auto,*,Auto" RowSpacing="8" IsVisible="False"
                      x:DataType="vm:SavedFeedsViewModel">
                  <Grid RowDefinitions="Auto,Auto" RowSpacing="2" Margin="2,0,2,4">
                    <TextBlock Text="{x:Static vm:AppText.SavedFeedsListTitle}" Classes="section-title" />
                    <TextBlock x:Name="SavedFeedsSummary" Grid.Row="1" Text="{Binding FeedsSummaryText}" Classes="caption"
                               Height="16" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FeedsSummaryText}"
                               AutomationProperties.LiveSetting="Polite" />
                  </Grid>
                  <Border x:Name="SavedFeedsCard" Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                    <Panel>
                      <TextBlock x:Name="SavedFeedsEmpty" Text="{Binding FeedsEmptyText}" Classes="caption" Margin="16,12"
                                 TextWrapping="Wrap" IsVisible="{Binding !HasFeeds}" />
                      <!-- Virtualized: every row has the fixed height of Border.row.notice -->
                      <ScrollViewer x:Name="SavedFeedsScroll" IsVisible="{Binding HasFeeds}">
                        <ItemsControl x:Name="SavedFeedsList" ItemsSource="{Binding Feeds}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedFeedRow">
                              <Border Classes="row notice" AutomationProperties.Name="{Binding AccessibleText}">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                  <!-- The name, its kind and its state, then the two times, so both times show whole -->
                                  <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                      <TextBlock Text="{Binding DisplayNameText}" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding DisplayNameText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding KindText}" Classes="caption"
                                                 VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Text="{Binding StateText}" Classes="small caution"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                      <TextBlock Text="{Binding LastWriteText}" Classes="caption"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastWriteText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding LastRefreshText}" Classes="caption"
                                                 Classes.caution="{Binding IsRefreshWarning}"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastRefreshTip}" />
                                    </Grid>
                                  </StackPanel>
                                  <!-- The commands are the page's, reached through the list's context -->
                                  <Button x:Name="RetireSavedFeedButton" Grid.Column="1" VerticalAlignment="Center"
                                          Content="{x:Static vm:AppText.RetireFeed}"
                                          Command="{Binding $parent[ItemsControl].((vm:SavedFeedsViewModel)DataContext).RetireCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="{Binding RetireName}"
                                          AutomationProperties.Name="{Binding RetireName}" />
                                  <Button x:Name="RemoveSavedFeedButton" Grid.Column="2" VerticalAlignment="Center"
                                          Content="{x:Static vm:AppText.RemoveSavedFeedButton}"
                                          Command="{Binding $parent[ItemsControl].((vm:SavedFeedsViewModel)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="{Binding RemoveName}"
                                          AutomationProperties.Name="{Binding RemoveName}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                  </Border>
                  <!-- Outcome of Retire feed, Remove and Clear history, in two lines; always there, so the page does not move -->
                  <TextBlock x:Name="SavedFeedsAction" Grid.Row="2" Text="{Binding ActionText}" Classes="caption"
                             Height="36" TextWrapping="Wrap" MaxLines="2" Classes.placeholder="{Binding !HasActionText}"
                             Classes.caution="{Binding IsActionWarning}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ActionText}" AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <!-- Change history: the search and filters, then the history card, which takes the height left -->
                <Grid x:Name="ChangeHistoryPage" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8" IsVisible="False"
                      x:DataType="vm:SavedFeedsViewModel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2"
                        Margin="2,0,2,4">
                    <TextBlock Text="{x:Static vm:AppText.HistoryListTitle}" Classes="section-title"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="HistorySummary" Grid.Row="1" Text="{Binding HistorySummaryText}" Classes="caption"
                               Height="16" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HistorySummaryText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="ClearHistoryButton" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Bottom"
                            Command="{Binding ClearHistoryCommand}"
                            AutomationProperties.Name="{x:Static vm:AppText.ClearHistoryButton}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:LineIcon Data="{StaticResource IconTrash2}" Classes="danger" />
                        <TextBlock Text="{x:Static vm:AppText.ClearHistoryButton}" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- Enter in the box searches (SavedFeedsSearchBoxKeyDown); the button is never the default -->
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="HistorySearchBox" Text="{Binding SearchText}" Classes="mono" MaxLength="64"
                             PlaceholderText="{x:Static vm:AppText.HistorySearchWatermark}"
                             AutomationProperties.Name="{x:Static vm:AppText.HistorySearchWatermark}"
                             KeyDown="SavedFeedsSearchBoxKeyDown" />
                    <Button x:Name="HistorySearchButton" Grid.Column="1" Command="{Binding SearchCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:LineIcon Data="{StaticResource IconSearch}" />
                        <TextBlock Text="{x:Static vm:AppText.HistorySearchButton}" />
                      </StackPanel>
                    </Button>
                    <ComboBox x:Name="HistoryFeedBox" Grid.Column="2" Width="200" ItemsSource="{Binding FeedChoices}"
                              SelectedItem="{Binding SelectedFeed}"
                              AutomationProperties.Name="{x:Static vm:AppText.HistoryFeedBoxName}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryFeedChoice">
                          <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="HistoryPeriodBox" Grid.Column="3" Width="150" ItemsSource="{Binding PeriodChoices}"
                              SelectedItem="{Binding SelectedPeriod}"
                              AutomationProperties.Name="{x:Static vm:AppText.HistoryPeriodBoxName}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryPeriodChoice">
                          <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <TextBlock x:Name="HistorySearchProblem" Grid.Row="2" Text="{Binding SearchProblemText}"
                             Classes="caption caution" Height="18" Classes.placeholder="{Binding !SearchProblemText.Length}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SearchProblemText}"
                             AutomationProperties.LiveSetting="Polite" />

                  <Border x:Name="HistoryCard" Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="36,*">
                      <!-- Two caption lines over the rows' two lines, in the same columns -->
                      <Grid Margin="16,0" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,128,160" ColumnSpacing="12">
                          <TextBlock Text="{x:Static vm:AppText.HistoryEntryHeader}" Classes="caption" />
                          <TextBlock Grid.Column="1" Text="{x:Static vm:AppText.HistoryChangeHeader}" Classes="caption" />
                          <TextBlock Grid.Column="2" Text="{x:Static vm:AppText.HistoryTimeHeader}" Classes="caption" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,128,160" ColumnSpacing="12">
                          <TextBlock Text="{x:Static vm:AppText.HistoryFeedHeader}" Classes="caption" />
                          <TextBlock Grid.Column="1" Text="{x:Static vm:AppText.HistoryCauseHeader}" Classes="caption" />
                          <TextBlock Grid.Column="2" Text="{x:Static vm:AppText.HistoryReasonHeader}" Classes="caption" />
                        </Grid>
                      </Grid>
                      <Panel Grid.Row="1">
                        <TextBlock x:Name="HistoryEmpty" Text="{Binding HistoryEmptyText}" Classes="caption" Margin="16,12"
                                   TextWrapping="Wrap" IsVisible="{Binding !HasHistoryRows}" />
                        <ScrollViewer x:Name="HistoryScroll" IsVisible="{Binding HasHistoryRows}">
                          <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryRows}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:HistoryChangeRow">
                                <!-- The row's tip is the whole change, its family and dataset included -->
                                <Border Classes="row notice" AutomationProperties.Name="{Binding AccessibleText}"
                                        ToolTip.Tip="{Binding AccessibleText}">
                                  <Grid RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,128,160" ColumnSpacing="12">
                                      <TextBlock Text="{Binding EntryText}" Classes="mono" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding EntryText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding ChangeText}" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding ChangeText}" />
                                      <TextBlock Grid.Column="2" Text="{Binding WhenText}" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding WhenText}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,128,160" ColumnSpacing="12">
                                      <TextBlock Text="{Binding FeedText}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding FeedText}" />
                                      <TextBlock Grid.Column="1" Text="{Binding CauseText}" Classes="caption"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CauseText}" />
                                      <TextBlock Grid.Column="2" Text="{Binding ReasonText}" Classes="caption"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReasonText}" />
                                    </Grid>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Panel>
                    </Grid>
                  </Border>

                  <!-- Outcome of Clear history, Retire feed and Remove, in two lines; always there, so the page does not move -->
                  <TextBlock x:Name="HistoryAction" Grid.Row="4" Text="{Binding ActionText}" Classes="caption"
                             Height="36" TextWrapping="Wrap" MaxLines="2" Classes.placeholder="{Binding !HasActionText}"
                             Classes.caution="{Binding IsActionWarning}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding ActionText}" AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <!-- Settings: only this page scrolls inside the frame, so the frame's minimum stays the tallest list
                     page's. The inputs are off while a save runs, because a save loads the saved values back. -->
                <Grid x:Name="SettingsPage" IsVisible="False" x:DataType="vm:SettingsPageViewModel">
                  <TextBlock x:Name="SettingsNotStartedText" Text="{x:Static vm:AppText.SettingsNotStarted}" Classes="secondary"
                             TextWrapping="Wrap" Margin="2,0" IsVisible="{Binding !IsStarted}" />
                  <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsStarted}">
                    <!-- The right margin keeps the scroll bar, which overlays the content, clear of the controls -->
                    <StackPanel Spacing="32" Margin="0,0,16,0">

                      <!-- Options -->
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,0,2,4">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static vm:AppText.OptionsHeader}" Classes="section-title" />
                            <TextBlock Text="{x:Static vm:AppText.OptionsCaption}" Classes="caption" />
                          </StackPanel>
                          <!-- Neither button is the default: Enter never saves -->
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button x:Name="SettingsRevertButton" Content="{x:Static vm:AppText.Revert}" MinWidth="88"
                                    Command="{Binding RevertSettingsCommand}" />
                            <Button x:Name="SettingsSaveButton" Content="{x:Static vm:AppText.SaveSettings}" MinWidth="88"
                                    Command="{Binding SaveSettingsCommand}" />
                          </StackPanel>
                        </Grid>
                        <Border x:Name="SettingsCard" Classes="card">
                          <StackPanel x:Name="SettingsInputs" Spacing="16" IsEnabled="{Binding CanEditInputs}">

                            <!-- Write feed -->
                            <vm:FeedTypesSection x:Name="FeedTypesSection" />

                            <!-- ASN export -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.AsnExportHeader}" Classes="body-strong" />
                              <CheckBox x:Name="FortigateEnabledBox" Content="{x:Static vm:AppText.AsnExportWritesFeeds}"
                                        IsChecked="{Binding Settings.FortigateEnabled}" />
                              <StackPanel Spacing="8" Margin="24,0,0,0">
                                <CheckBox x:Name="FortigateIPv4Box" Content="{x:Static vm:AppText.IncludeIPv4}"
                                          IsChecked="{Binding Settings.FortigateIncludeIPv4}" IsEnabled="{Binding Settings.FortigateEnabled}" />
                                <CheckBox x:Name="FortigateIPv6Box" Content="{x:Static vm:AppText.IncludeIPv6}"
                                          IsChecked="{Binding Settings.FortigateIncludeIPv6}" IsEnabled="{Binding Settings.CanEditFortigateIPv6}" />
                                <CheckBox x:Name="FortigateSplitBox" Content="{x:Static vm:AppText.SplitByFamily}"
                                          IsChecked="{Binding Settings.FortigateSplitByFamily}" IsEnabled="{Binding Settings.FortigateEnabled}" />
                              </StackPanel>
                            </StackPanel>

                            <!-- Export folder -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.ExportFolderHeader}" Classes="body-strong" />
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock x:Name="ExportFolderText" Classes="caption quaternary" Text="{Binding Settings.ExportFolder}"
                                           TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Settings.ExportFolder}" />
                                <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="{x:Static vm:AppText.ChooseFolder}"
                                        Command="{Binding ChooseFolderCommand}" />
                                <Button x:Name="UseDefaultButton" Grid.Column="2" Content="{x:Static vm:AppText.UseDefault}"
                                        Command="{Binding UseDefaultFolderCommand}" />
                              </Grid>
                            </StackPanel>

                            <!-- IPv6 -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.IPv6Header}" Classes="body-strong" />
                              <CheckBox x:Name="IPv6EnabledBox" Content="{x:Static vm:AppText.IPv6Enabled}"
                                        IsChecked="{Binding Settings.IPv6Enabled}" />
                              <TextBlock Text="{x:Static vm:AppText.IPv6Caption}" Classes="caption" TextWrapping="Wrap" Margin="24,0,0,0" />
                            </StackPanel>

                            <!-- Large ranges -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.LargeRangesHeader}" Classes="body-strong" />
                              <CheckBox x:Name="LargeRangeCheckBox" Content="{x:Static vm:AppText.AskLargeRanges}"
                                        IsChecked="{Binding Settings.LargeRangeCheckEnabled}" />
                              <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12" Margin="24,0,0,0">
                                <TextBlock Text="{x:Static vm:AppText.IPv4PrefixLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="IPv4PrefixBox" Grid.Column="1" Minimum="1" Maximum="32" Increment="1" FormatString="0"
                                               Value="{Binding Settings.IPv4MinPrefix}" IsEnabled="{Binding Settings.LargeRangeCheckEnabled}"
                                               AutomationProperties.Name="{x:Static vm:AppText.IPv4PrefixLabel}" />
                                <TextBlock Grid.Row="1" Text="{x:Static vm:AppText.IPv6PrefixLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="IPv6PrefixBox" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="128" Increment="1"
                                               FormatString="0" Value="{Binding Settings.IPv6MinPrefix}"
                                               IsEnabled="{Binding Settings.CanEditIPv6Prefix}"
                                               AutomationProperties.Name="{x:Static vm:AppText.IPv6PrefixLabel}" />
                              </Grid>
                            </StackPanel>

                            <!-- AbuseIPDB -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.AbuseIpDbHeader}" Classes="body-strong" />
                              <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                                <TextBlock Text="{x:Static vm:AppText.AbuseIpDbKeepDaysLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="AbuseIpDbKeepDaysBox" Grid.Column="1" Minimum="1" Maximum="365" Increment="1"
                                               FormatString="0" Value="{Binding Settings.AbuseIpDbKeepDays}"
                                               AutomationProperties.Name="{x:Static vm:AppText.AbuseIpDbKeepDaysLabel}" />
                              </Grid>
                              <TextBlock Text="{x:Static vm:AppText.AbuseIpDbKeepDaysCaption}" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Refresh all -->
                            <StackPanel Spacing="8">
                              <TextBlock Text="{x:Static vm:AppText.RefreshAllHeader}" Classes="body-strong" />
                              <CheckBox x:Name="RefreshAllOnTimerBox" Content="{x:Static vm:AppText.RefreshAllOnTimer}"
                                        IsChecked="{Binding Settings.RefreshAllOnTimer}"
                                        AutomationProperties.Name="{x:Static vm:AppText.RefreshAllOnTimer}" />
                              <Grid ColumnDefinitions="*,120" ColumnSpacing="12" Margin="24,0,0,0">
                                <TextBlock Text="{x:Static vm:AppText.RefreshAllEveryHoursLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="RefreshAllEveryHoursBox" Grid.Column="1" Minimum="1" Maximum="24" Increment="1"
                                               FormatString="0" Value="{Binding Settings.RefreshAllEveryHours}"
                                               IsEnabled="{Binding Settings.CanEditRefreshAllHours}"
                                               AutomationProperties.Name="{x:Static vm:AppText.RefreshAllEveryHoursLabel}" />
                              </Grid>
                              <TextBlock Text="{x:Static vm:AppText.RefreshAllTimerCaption}" Classes="caption" TextWrapping="Wrap" Margin="24,0,0,0" />
                            </StackPanel>

                          </StackPanel>
                        </Border>
                        <!-- Fixed height, so the page doesn't move when the line appears or goes -->
                        <TextBlock x:Name="SettingsStatus" Classes="small" Height="18" Text="{Binding SettingsStatusText}"
                                   Classes.critical="{Binding IsSettingsStatusError}" Classes.secondary="{Binding !IsSettingsStatusError}"
                                   Classes.placeholder="{Binding !HasSettingsStatus}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SettingsStatusText}" AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>

                      <!-- API keys -->
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2" Margin="2,0,2,4">
                          <TextBlock Text="{x:Static vm:AppText.KeysHeader}" Classes="section-title" />
                          <TextBlock Text="{x:Static vm:AppText.KeysCaption}" Classes="caption" />
                        </StackPanel>
                        <Border x:Name="KeysCard" Classes="card">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <TextBlock x:Name="TokenStatus" Text="{Binding TokenStatusText}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                              <Button x:Name="ResetTokenButton" Grid.Column="1" Content="{x:Static vm:AppText.ResetTokenButton}"
                                      MinWidth="88" Command="{Binding ResetTokenCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                              <TextBlock x:Name="AbuseKeyStatus" Text="{Binding AbuseKeyStatusText}" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AbuseKeyStatusText}" />
                              <Button x:Name="SetAbuseKeyButton" Grid.Column="1" Content="{x:Static vm:AppText.SetAbuseKey}"
                                      MinWidth="88" Command="{Binding SetAbuseKeyCommand}" />
                              <Button x:Name="RemoveAbuseKeyButton" Grid.Column="2" Content="{x:Static vm:AppText.RemoveAbuseKey}"
                                      MinWidth="88" Command="{Binding RemoveAbuseKeyCommand}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                        <TextBlock x:Name="KeysStatus" Classes="caption" Height="18" Text="{Binding KeysStatusText}"
                                   Classes.placeholder="{Binding !HasKeysStatus}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>

                      <!-- Exceptions: Enter in the network or note box adds the network (handled in code-behind); Add is
                           not a default button, so Enter anywhere else on the page adds nothing, and Enter never saves -->
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="2,0,2,4">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static vm:AppText.ExceptionsTitle}" Classes="section-title" />
                            <TextBlock Text="{x:Static vm:AppText.ExceptionsMessage}" Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button x:Name="ExceptionsRevertButton" Content="{x:Static vm:AppText.Revert}" MinWidth="88"
                                    Command="{Binding RevertExceptionsCommand}" />
                            <Button x:Name="ExceptionsSaveButton" Content="{x:Static vm:AppText.SaveExceptions}" MinWidth="88"
                                    Command="{Binding SaveExceptionsCommand}" />
                          </StackPanel>
                        </Grid>
                        <!-- The network and note boxes sit over the list's columns: both start 16 in, and the 368 and 12
                             match the rows' network column and spacing -->
                        <Border x:Name="ExceptionsEditor" Classes="card compact" IsEnabled="{Binding CanEditInputs}">
                          <Grid ColumnDefinitions="368,*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="NetworkBox" Classes="mono" Text="{Binding Exceptions.NetworkText}" MaxLength="64"
                                     KeyDown="ExceptionBoxKeyDown"
                                     PlaceholderText="{x:Static vm:AppText.ExceptionNetworkPlaceholder}"
                                     AutomationProperties.Name="{x:Static vm:AppText.ExceptionNetworkName}" />
                            <TextBox x:Name="NoteBox" Grid.Column="1" Text="{Binding Exceptions.NoteText}" MaxLength="200"
                                     KeyDown="ExceptionBoxKeyDown"
                                     PlaceholderText="{x:Static vm:AppText.ExceptionNotePlaceholder}"
                                     AutomationProperties.Name="{x:Static vm:AppText.ExceptionNoteName}" />
                            <Button x:Name="AddExceptionButton" Grid.Column="2" Content="{x:Static vm:AppText.AddException}"
                                    MinWidth="88" Command="{Binding AddExceptionCommand}" />
                          </Grid>
                        </Border>
                        <!-- Fixed height, so the page doesn't move when the line appears or goes -->
                        <TextBlock x:Name="FeedbackTextBlock" Height="18" Classes="small" Text="{Binding Exceptions.FeedbackText}"
                                   Classes.critical="{Binding Exceptions.IsFeedbackError}" Classes.secondary="{Binding !Exceptions.IsFeedbackError}"
                                   Classes.placeholder="{Binding !Exceptions.HasFeedback}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />

                        <!-- A fixed-height list: the card clips it and the scroll viewer scrolls it. Rows are one height, so
                             virtualization holds. -->
                        <Border x:Name="ExceptionsListCard" Classes="card" Padding="0" ClipToBounds="True" Height="216"
                                IsEnabled="{Binding CanEditInputs}">
                          <Panel>
                            <TextBlock x:Name="ExceptionsEmpty" Text="{x:Static vm:AppText.ExceptionsEmpty}" Classes="caption"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Exceptions.HasRows}" />
                            <ScrollViewer x:Name="ExceptionsScroll" IsVisible="{Binding Exceptions.HasRows}">
                              <ItemsControl x:Name="ExceptionItems" ItemsSource="{Binding Exceptions.Rows}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ExceptionRow">
                                    <!-- Transparent, so a right-click in a gap between
                                         the columns still reaches the row's menu -->
                                    <Border Classes="row" Background="Transparent">
                                      <Border.ContextMenu>
                                        <ContextMenu>
                                          <!-- Level 1: the menu is itself an ItemsControl,
                                               so the first one up is the menu, not the list -->
                                          <MenuItem Header="{x:Static vm:AppText.CopyNetwork}"
                                                    Command="{Binding $parent[ItemsControl;1].((vm:SettingsPageViewModel)DataContext).CopyExceptionNetworkCommand}"
                                                    CommandParameter="{Binding}" />
                                        </ContextMenu>
                                      </Border.ContextMenu>
                                      <!-- 368 fits the longest network, 46 characters of Geist Mono, so no network
                                           trims at the minimum width; the note takes the rest and trims -->
                                      <Grid ColumnDefinitions="368,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding NetworkText}" Classes="mono" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding NetworkText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NoteText}" Classes="caption" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding NoteText}" />
                                        <Button Grid.Column="2" Classes="subtle small" VerticalAlignment="Center"
                                                Command="{Binding RemoveCommand}" ToolTip.Tip="{Binding RemoveName}"
                                                AutomationProperties.Name="{Binding RemoveName}">
                                          <ui:LineIcon Data="{StaticResource IconX}" Width="14" Height="14" />
                                        </Button>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>
                          </Panel>
                        </Border>
                        <TextBlock x:Name="ExceptionsCountText" Classes="caption" Text="{Binding Exceptions.CountText}" />
                        <TextBlock x:Name="ExceptionsStatus" Classes="small" Height="18" Text="{Binding ExceptionsStatusText}"
                                   Classes.critical="{Binding IsExceptionsStatusError}" Classes.secondary="{Binding !IsExceptionsStatusError}"
                                   Classes.placeholder="{Binding !HasExceptionsStatus}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>

                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Panel>
            </Grid>
          </Border>
        </ScrollViewer>

        <!-- The start-up stop: shown in place of every page once start-up has stopped, with the way on when there is
             one. It swaps once per start-up, not while work runs, so IsVisible is right here. -->
        <ScrollViewer x:Name="StartupStop" IsVisible="{Binding IsStopped}" HorizontalScrollBarVisibility="Disabled">
          <Border x:Name="StartupStopCard" Classes="infobar error" MaxWidth="540" Margin="32" HorizontalAlignment="Center"
                  VerticalAlignment="Top">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ui:LineIcon Classes="severity" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock x:Name="StartupStopTitle" Text="{Binding StopTitle}" Classes="subtitle" TextWrapping="Wrap" />
                  <SelectableTextBlock x:Name="StartupStopText" Text="{Binding StopText}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="StartupStopAction" Classes="small" Height="18" Text="{Binding StopActionText}"
                         Classes.critical="{Binding IsStopActionError}" Classes.secondary="{Binding !IsStopActionError}"
                         Classes.placeholder="{Binding !HasStopAction}" AutomationProperties.LiveSetting="Polite" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="StartWithoutOldExceptionsButton" Content="{x:Static vm:AppText.StartWithoutOldExceptionsButton}"
                        Command="{Binding StartWithoutOldExceptionsCommand}" IsVisible="{Binding CanStartWithoutOldExceptions}" />
                <Button x:Name="StartFreshButton" Content="{x:Static vm:AppText.StartFreshButton}"
                        Command="{Binding StartFreshCommand}" IsVisible="{Binding CanStartFresh}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</Window>
