<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PoorMansFeed"
        x:Class="PoorMansFeed.SettingsDialog"
        x:DataType="local:SettingsDialogModel"
        Title="{x:Static local:AppText.SettingsTitle}"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="24" RowSpacing="16">
    <TextBlock x:Name="TitleText" Text="{x:Static local:AppText.SettingsTitle}" Classes="subtitle" />

    <ScrollViewer Grid.Row="1" MaxHeight="560">
      <StackPanel Spacing="16">

        <!-- Export folder -->
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:AppText.ExportFolderHeader}" Classes="body-strong" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="ExportFolderText" Classes="caption quaternary" Text="{Binding ExportFolder}"
                       TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ExportFolder}" />
            <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="{x:Static local:AppText.ChooseFolder}"
                    Click="ChooseFolderClicked" />
            <Button x:Name="UseDefaultButton" Grid.Column="2" Content="{x:Static local:AppText.UseDefault}"
                    Click="UseDefaultClicked" />
          </Grid>
        </StackPanel>

        <!-- IPv6 -->
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:AppText.IPv6Header}" Classes="body-strong" />
          <CheckBox x:Name="IPv6EnabledBox" Content="{x:Static local:AppText.IPv6Enabled}" IsChecked="{Binding IPv6Enabled}" />
          <TextBlock Text="{x:Static local:AppText.IPv6Caption}" Classes="caption" TextWrapping="Wrap" Margin="24,0,0,0" />
        </StackPanel>

        <!-- Fortigate threat feed -->
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:AppText.FortigateHeader}" Classes="body-strong" />
          <CheckBox Content="{x:Static local:AppText.FortigateEnabled}" IsChecked="{Binding FortigateEnabled}" />
          <StackPanel Spacing="8" Margin="24,0,0,0">
            <CheckBox Content="{x:Static local:AppText.IncludeIPv4}" IsChecked="{Binding FortigateIncludeIPv4}"
                      IsEnabled="{Binding FortigateEnabled}" />
            <CheckBox x:Name="FortigateIPv6Box" Content="{x:Static local:AppText.IncludeIPv6}" IsChecked="{Binding FortigateIncludeIPv6}"
                      IsEnabled="{Binding CanEditFortigateIPv6}" />
            <CheckBox Content="{x:Static local:AppText.SplitByFamily}" IsChecked="{Binding FortigateSplitByFamily}"
                      IsEnabled="{Binding FortigateEnabled}" />
          </StackPanel>
        </StackPanel>

        <!-- Large ranges -->
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:AppText.LargeRangesHeader}" Classes="body-strong" />
          <CheckBox Content="{x:Static local:AppText.AskLargeRanges}" IsChecked="{Binding LargeRangeCheckEnabled}" />
          <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12" Margin="24,0,0,0">
            <TextBlock Text="{x:Static local:AppText.IPv4PrefixLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="32" Increment="1" FormatString="0"
                           Value="{Binding IPv4MinPrefix}" IsEnabled="{Binding LargeRangeCheckEnabled}"
                           AutomationProperties.Name="{x:Static local:AppText.IPv4PrefixLabel}" />
            <TextBlock Grid.Row="1" Text="{x:Static local:AppText.IPv6PrefixLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="128" Increment="1" FormatString="0"
                           Value="{Binding IPv6MinPrefix}" IsEnabled="{Binding CanEditIPv6Prefix}"
                           AutomationProperties.Name="{x:Static local:AppText.IPv6PrefixLabel}" />
          </Grid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Fixed height, so the window never changes size when the message appears or goes. Hidden with its space when valid. -->
    <TextBlock x:Name="ValidationTextBlock" Grid.Row="2" Classes="small critical" Height="18" Text="{Binding ValidationText}"
               Classes.placeholder="{Binding IsValid}" AutomationProperties.LiveSetting="Polite" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="{x:Static local:AppText.Cancel}" MinWidth="88" IsCancel="True" Click="CancelClicked" />
      <!-- Not the default button: Enter alone must not save the settings -->
      <Button x:Name="SaveButton" Content="{x:Static local:AppText.Save}" MinWidth="88" IsEnabled="{Binding IsValid}"
              Click="SaveClicked" />
    </StackPanel>
  </Grid>
</Window>
